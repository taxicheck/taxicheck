---
import "../styles/site.css";
import { LANGS } from "../lib/data.js";
import { EX } from "../lib/texts.js";
import { BG_MAIN } from "../lib/photos.js";
const { lang, title, description, path = "", bg = BG_MAIN } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = (Astro.site?.toString() || "").replace(/\/$/, "");
const href = (l) => `${base}/${l}/${path}`;
const FOOT = {
  ru: { imp: "Impressum", dat: "Конфиденциальность (Datenschutz)", home: "Главная", bg: "Фото фона" },
  de: { imp: "Impressum", dat: "Datenschutz", home: "Startseite", bg: "Hintergrundfoto" },
  en: { imp: "Impressum", dat: "Privacy (Datenschutz)", home: "Home", bg: "Background photo" },
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={`${site}${href(lang)}`}>
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={`${site}${href(l)}`}>)}
  <link rel="alternate" hreflang="x-default" href={`${site}${href("de")}`}>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
  <meta name="theme-color" content="#f2b705">
  {import.meta.env.PUBLIC_NOINDEX === "1" && <meta name="robots" content="noindex">}
</head>
<body>
  <div class="backdrop" aria-hidden="true" style={`background-image:url(${base}/${bg.src})`}></div>
  <div class="wrap">
    <header>
      <div class="top">
        <a href={href(lang).replace(path, "")} class="logo" style="color:inherit;text-decoration:none"><span class="sign">TAXI</span>Check</a>
        <nav class="langs" aria-label="Language">
          {LANGS.map((l) => <a href={href(l)} hreflang={l} aria-current={l === lang ? "page" : undefined}>{l.toUpperCase()}</a>)}
        </nav>
      </div>
      <nav class="main-nav"><a href={`${base}/${lang}/`} aria-current={path === "" ? "page" : undefined}>{EX[lang].navDe}</a><a href={`${base}/${lang}/countries/`} aria-current={path.startsWith("countries") ? "page" : undefined}>{EX[lang].navCountries}</a></nav>
      <slot name="header" />
    </header>
    <slot />
    <footer>
      <slot name="footer" />
      <nav class="foot-nav">
        <a href={`${base}/${lang}/`}>{FOOT[lang].home}</a>
        <a href={`${base}/${lang}/impressum/`}>{FOOT[lang].imp}</a>
        <a href={`${base}/${lang}/datenschutz/`}>{FOOT[lang].dat}</a>
      </nav>
      <p class="bg-credit">{FOOT[lang].bg}: <a href={bg.url} rel="noopener">{bg.by}</a>, {bg.lic} · Wikimedia Commons</p>
    </footer>
  </div>
</body>
</html>
