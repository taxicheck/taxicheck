---
import "../styles/site.css";
import { LANGS } from "../lib/data.js";
import { EX } from "../lib/texts.js";
import { BG_MAIN } from "../lib/photos.js";
import { SLOGAN } from "../lib/city.js";
const { lang, title, description, path = "", bg = BG_MAIN, credits = [] } = Astro.props;
const PH = { ru: "Фото", de: "Fotos", en: "Photos" };
const alt = (p) => (p.alt ? (typeof p.alt === "string" ? p.alt : p.alt[lang]) : "");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = (Astro.site?.toString() || "").replace(/\/$/, "");
const href = (l) => `${base}/${l}/${path}`;
const NAMES = { de: "Deutsch", en: "English", ru: "Русский" };
const FLAG = {
  de: '<svg viewBox="0 0 5 3" aria-hidden="true"><rect width="5" height="1" fill="#000"/><rect y="1" width="5" height="1" fill="#D00"/><rect y="2" width="5" height="1" fill="#FFCE00"/></svg>',
  en: '<svg viewBox="0 0 60 30" aria-hidden="true"><clipPath id="fgb"><path d="M0 0v30h60V0z"/></clipPath><clipPath id="fgt"><path d="M30 15h30v15zv15H0zH0V0zV0h30z"/></clipPath><g clip-path="url(#fgb)"><path d="M0 0v30h60V0z" fill="#012169"/><path d="M0 0l60 30m0-30L0 30" stroke="#fff" stroke-width="6"/><path d="M0 0l60 30m0-30L0 30" clip-path="url(#fgt)" stroke="#C8102E" stroke-width="4"/><path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10"/><path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6"/></g></svg>',
  ru: '<svg viewBox="0 0 9 6" aria-hidden="true"><rect width="9" height="2" fill="#fff"/><rect y="2" width="9" height="2" fill="#0039A6"/><rect y="4" width="9" height="2" fill="#D52B1E"/></svg>',
};
const OG_LOCALE = { ru: "ru_RU", de: "de_DE", en: "en_GB" };
const FOOT = {
  ru: { imp: "Impressum", dat: "Конфиденциальность (Datenschutz)", home: "Главная", bg: "Фото фона" },
  de: { imp: "Impressum", dat: "Datenschutz", home: "Startseite", bg: "Hintergrundfoto" },
  en: { imp: "Impressum", dat: "Privacy (Datenschutz)", home: "Home", bg: "Background photo" },
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={`${site}${href(lang)}`}>
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={`${site}${href(l)}`}>)}
  <link rel="alternate" hreflang="x-default" href={`${site}${href("de")}`}>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="TaxiCheck">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={`${site}${href(lang)}`}>
  <meta property="og:locale" content={OG_LOCALE[lang]}>
  <meta property="og:image" content={`${site}${base}/og-image.jpg`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="TaxiCheck: Taxi, Uber, Bolt, FREE NOW, Transfer">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={`${site}${base}/og-image.jpg`}>
  <meta name="theme-color" content="#f2b705">
  {import.meta.env.PUBLIC_NOINDEX === "1" && <meta name="robots" content="noindex">}
</head>
<body>
  <div class="backdrop" aria-hidden="true"></div>
  <div class="wrap">
    <header>
      <div class="top">
        <a href={href(lang).replace(path, "")} class="logo" aria-label="TaxiCheck"><span class="sign">TAXI</span>Check</a>
        <nav class="flags" aria-label="Sprache · Language · Язык">
          {["de", "en", "ru"].map((l) => <a href={href(l)} hreflang={l} lang={l} title={NAMES[l]} aria-label={NAMES[l]} aria-current={l === lang ? "page" : undefined}><Fragment set:html={FLAG[l]} /><span>{l.toUpperCase()}</span></a>)}
        </nav>
      </div>
      <nav class="main-nav" aria-label="Menu"><a href={`${base}/${lang}/`} aria-current={path === "" ? "page" : undefined}>{EX[lang].navDe}</a><a href={`${base}/${lang}/munich/`} aria-current={path.startsWith("munich") ? "page" : undefined}>{EX[lang].navCity}</a><a href={`${base}/${lang}/countries/`} aria-current={path.startsWith("countries") ? "page" : undefined}>{EX[lang].navCountries}</a></nav>
      <slot name="header" />
    </header>
    <slot />
    <footer>
      <slot name="footer" />
      <nav class="foot-nav">
        <a href={`${base}/${lang}/`}>{FOOT[lang].home}</a>
        <a href={`${base}/${lang}/impressum/`}>{FOOT[lang].imp}</a>
        <a href={`${base}/${lang}/datenschutz/`}>{FOOT[lang].dat}</a>
      </nav>
      <p class="foot-slogan"><span class="sign">TAXI</span> {SLOGAN[lang]}</p>
      {credits.length > 0 && <p class="bg-credit">{PH[lang]}: {credits.map((p, i) => <>{i ? " · " : ""}{alt(p)} — <a href={p.url} rel="noopener">{p.by}</a>, {p.lic}</>)} · Wikimedia Commons</p>}
    </footer>
  </div>
</body>
</html>
