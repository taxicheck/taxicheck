---
// Корень сайта: основной язык — немецкий, всегда /de/.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TaxiCheck</title>
  <meta name="robots" content="noindex">
  <meta http-equiv="refresh" content={`0;url=${base}/de/`}>
  <script is:inline define:vars={{ base }}>
    location.replace(base + "/de/");
  </script>
</head>
<body style="font-family:system-ui,sans-serif;padding:24px">
  <p><a href={`${base}/de/`}>Deutsch</a> · <a href={`${base}/ru/`}>Русский</a> · <a href={`${base}/en/`}>English</a></p>
</body>
</html>
