---
// Корень сайта: язык телефона/компьютера (ru, en), иначе немецкий. Выбранный флажком язык запоминается.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TaxiCheck</title>
  <meta name="robots" content="noindex">
  <meta http-equiv="refresh" content={`0;url=${base}/de/`}>
  <script is:inline define:vars={{ base }}>
    var L = ["de", "en", "ru"], pick = null;
    try { pick = localStorage.getItem("tc-lang"); } catch (e) {}
    if (L.indexOf(pick) < 0) {
      pick = "de";
      var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || "de"];
      for (var i = 0; i < list.length; i++) { var c = String(list[i]).slice(0, 2).toLowerCase(); if (L.indexOf(c) >= 0) { pick = c; break; } }
    }
    location.replace(base + "/" + pick + "/");
  </script>
</head>
<body style="font-family:system-ui,sans-serif;padding:24px">
  <p><a href={`${base}/de/`}>Deutsch</a> · <a href={`${base}/ru/`}>Русский</a> · <a href={`${base}/en/`}>English</a></p>
</body>
</html>
