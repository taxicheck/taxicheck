---
// Главная: одна задача — сравнить цену поездки по Мюнхену и открыть нужное приложение.
// Всё остальное (город, страны) — по ссылкам внизу. Цены — ориентиры, требуют проверки.
import Base from "../../layouts/Base.astro";
import { LANGS, ROUTES, PLACES, LINKS, TARIFF } from "../../lib/data.js";
import { meter } from "../../lib/render.js";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const loc = lang === "ru" ? "ru-RU" : lang === "de" ? "de-DE" : "en-GB";
const eur = (n) => n.toLocaleString(loc, { maximumFractionDigits: 0 }) + " €";

const T = {
  de: {
    title: "Taxi, Uber, Bolt oder FREE NOW – was ist in München günstiger? | TaxiCheck",
    desc: "Strecke wählen, Preise vergleichen, App öffnen: Taxi-Festpreis, Uber, Bolt und FREE NOW in München. Alle Preise unverbindlich.",
    h1: "Was ist günstiger: Taxi, Uber, Bolt oder FREE NOW?",
    lead: "München · Strecke wählen – Preise sehen – App öffnen.",
    where: "Wohin fahren Sie?", gps: "Meinen Standort nutzen", gpsNo: "Standort nicht verfügbar – bitte Strecke wählen.", gpsFar: "Sie sind nicht direkt an Flughafen, Hbf oder Messe – wählen Sie „Andere Strecke“.",
    now: "Jetzt sofort", pre: "Vorab buchen",
    fixH: "Taxi-Festpreis", fixNote: "Preis ändert sich nicht – am Taxistand und bei Bestellung per Taxi-App. Kein Taxameter.",
    appsH: "Apps – Preis schwankt mit Nachfrage und Verkehr",
    best: "Günstigste Option", inApp: "Preis in der App", avg: "Ø laut Uber, 1 Monat",
    open: "App öffnen", openWeb: "Öffnen", book: "Ansehen",
    preNote: "Mit Vorlauf buchen – der Fahrer wartet mit Namensschild.",
    preEmpty: "Für diese Strecke haben wir noch keine geprüften Transferpreise.",
    sbahn: "Ohne Taxi: S-Bahn ins Zentrum 11,60 € (ca. 40 Min.).",
    ownH: "Andere Strecke", km: "Entfernung in km", meterH: "Taxi nach Taxameter", meterNote: (lo, hi) => `ca. ${lo}–${hi}, ohne und mit Stau. Tarif München, Stand ${TARIFF.date}.`,
    uberNote: "Uber öffnet sich mit Ihrem Standort – Ziel in der App eingeben.",
    tipsH: "Tipps aus der Praxis", author: "Von einem Vielreisenden, der das Geschäft von beiden Seiten kennt – vom Fahrersitz und von der Rückbank.",
    tips: ["Vor dem Einsteigen nach dem Preis fragen. Auf Festpreis-Strecken gilt der Festpreis – nicht mehr.", "Uber, Bolt und FREE NOW zur selben Minute vergleichen: der Preis springt bei Regen, Messe und Wiesn.", "Schon gelandet und nichts gebucht? Taxi am Ausgang oder eine App. Transfers bucht man vorab."],
    stand: "Alle Preise sind unverbindliche Richtwerte ohne Gewähr, Stand 11/2026. Maßgeblich ist der Preis in der App bzw. das Taxameter. Links öffnen die Seiten und Apps der Anbieter; TaxiCheck ist mit ihnen nicht verbunden.",
    more: "Mehr", moreCity: ["München-Guide", "Sehenswertes, Essen, Events"], moreCountries: ["Taxi-Tipps nach Ländern", "9 Länder, vom Flughafen ins Zentrum"],
    vs: (d) => `${d} günstiger als das Taxi`, ad: "",
  },
  ru: {
    title: "Такси, Uber, Bolt или FREE NOW — что дешевле в Мюнхене? | TaxiCheck",
    desc: "Выберите маршрут, сравните цены, откройте приложение: фиксированная цена такси, Uber, Bolt и FREE NOW в Мюнхене. Цены ориентировочные.",
    h1: "Что дешевле: такси, Uber, Bolt или FREE NOW?",
    lead: "Мюнхен · выберите маршрут — увидите цены — откройте приложение.",
    where: "Куда едете?", gps: "Определить, где я", gpsNo: "Местоположение недоступно — выберите маршрут.", gpsFar: "Вы не у аэропорта, вокзала или Messe — выберите «Другой маршрут».",
    now: "Прямо сейчас", pre: "Заранее",
    fixH: "Такси: фиксированная цена", fixNote: "Цена не меняется — на стоянке такси и при заказе через приложение такси. Без счётчика.",
    appsH: "Приложения — цена зависит от спроса и пробок",
    best: "Самый дешёвый вариант", inApp: "Цена в приложении", avg: "в среднем по данным Uber за месяц",
    open: "Открыть приложение", openWeb: "Открыть", book: "Смотреть",
    preNote: "Бронь заранее — водитель встречает с табличкой.",
    preEmpty: "Для этого маршрута проверенных цен трансфера пока нет.",
    sbahn: "Без такси: S-Bahn в центр 11,60 € (около 40 мин).",
    ownH: "Другой маршрут", km: "Расстояние, км", meterH: "Такси по счётчику", meterNote: (lo, hi) => `около ${lo}–${hi}, без пробок и с пробками. Тариф Мюнхена от ${TARIFF.date}.`,
    uberNote: "Uber откроется с вашим местоположением — цель введите в приложении.",
    tipsH: "Советы из практики", author: "От человека, который много ездил по миру и знает такси с обеих сторон — за рулём и на заднем сиденье.",
    tips: ["Спросите цену до посадки. Где действует фиксированная цена — платите её, не больше.", "Сравните Uber, Bolt и FREE NOW в одну и ту же минуту: цена прыгает в дождь, во время выставок и Октоберфеста.", "Уже прилетели и ничего не заказали? Такси у выхода или приложение. Трансфер бронируют заранее."],
    stand: "Все цены — ориентировочные, без гарантии, на 11.2026. Окончательная цена — в приложении или по счётчику. Ссылки ведут на сайты и приложения сервисов; TaxiCheck с ними не связан.",
    more: "Ещё", moreCity: ["Мюнхен: гид", "что посмотреть, где поесть, события"], moreCountries: ["Такси в других странах", "9 стран: из аэропорта в центр"],
    vs: (d) => `на ${d} дешевле такси`, ad: "",
  },
  en: {
    title: "Taxi, Uber, Bolt or FREE NOW – what's cheaper in Munich? | TaxiCheck",
    desc: "Pick a route, compare prices, open the app: Munich taxi fixed fare, Uber, Bolt and FREE NOW. All prices are estimates.",
    h1: "What's cheaper: taxi, Uber, Bolt or FREE NOW?",
    lead: "Munich · pick a route – see prices – open the app.",
    where: "Where are you going?", gps: "Use my location", gpsNo: "Location unavailable – please pick a route.", gpsFar: "You're not right at the airport, Hbf or Messe – choose “Other route”.",
    now: "Right now", pre: "Book ahead",
    fixH: "Taxi fixed fare", fixNote: "Price doesn't change – at the taxi rank and when booking via a taxi app. No meter.",
    appsH: "Apps – price changes with demand and traffic",
    best: "Cheapest option", inApp: "Price in the app", avg: "avg. per Uber, 1 month",
    open: "Open app", openWeb: "Open", book: "View",
    preNote: "Book in advance – the driver waits with a name sign.",
    preEmpty: "No checked transfer prices for this route yet.",
    sbahn: "Without a taxi: S-Bahn to the centre 11.60 € (about 40 min).",
    ownH: "Other route", km: "Distance in km", meterH: "Taxi by meter", meterNote: (lo, hi) => `about ${lo}–${hi}, without and with traffic. Munich tariff as of ${TARIFF.date}.`,
    uberNote: "Uber opens at your location – enter the destination in the app.",
    tipsH: "Tips from practice", author: "From a seasoned traveller who knows the trade from both sides – behind the wheel and in the back seat.",
    tips: ["Ask the price before you get in. On fixed-fare routes the fixed fare applies – no more.", "Compare Uber, Bolt and FREE NOW at the same minute: prices jump in rain, trade fairs and Oktoberfest.", "Landed with nothing booked? Taxi at the exit or an app. Transfers are booked in advance."],
    stand: "All prices are non-binding estimates without guarantee, as of 11/2026. The app price or the meter is what counts. Links open the providers' sites and apps; TaxiCheck is not affiliated with them.",
    more: "More", moreCity: ["Munich guide", "sights, food, events"], moreCountries: ["Taxi tips by country", "9 countries, airport to centre"],
    vs: (d) => `${d} cheaper than the taxi`, ad: "",
  },
}[lang];

const PNAME = {
  air: { de: "Flughafen", ru: "Аэропорт", en: "Airport" },
  hbf: { de: "Hauptbahnhof", ru: "Главный вокзал", en: "Central Station" },
  messe: { de: "Messe", ru: "Messe (выставка)", en: "Messe (trade fair)" },
};

// Ссылки «открыть»: Uber понимает маршрут в ссылке (откроет приложение, если оно есть, иначе сайт).
// Bolt и FREE NOW публичной ссылки с маршрутом не дают — открываем их страницу.
const uberLink = (from, to) => {
  const q = new URLSearchParams({ action: "setPickup" });
  if (from) { q.set("pickup[latitude]", from.lat); q.set("pickup[longitude]", from.lng); q.set("pickup[nickname]", from.n); } else q.set("pickup", "my_location");
  if (to) { q.set("dropoff[latitude]", to.lat); q.set("dropoff[longitude]", to.lng); q.set("dropoff[nickname]", to.n); }
  return "https://m.uber.com/ul/?" + q.toString();
};
const BOLT = lang === "de" ? "https://bolt.eu/de-de/rides/" : "https://bolt.eu/en-de/rides/";
const FREENOW = LINKS.freenow;

const routes = ROUTES.filter((r) => r.id !== "own").map((r) => {
  const from = PLACES[r.from], to = PLACES[r.to];
  const apps = [
    { k: "uber", n: "Uber X", c: "#111", price: r.uber?.x, note: r.uber ? T.avg : "", href: uberLink(from, to), app: true },
    ...(r.uber?.comfort ? [{ k: "uber", n: "Uber Comfort", c: "#111", price: r.uber.comfort, note: T.avg, href: uberLink(from, to), app: true }] : []),
    { k: "bolt", n: "Bolt", c: "#2a9d5c", href: BOLT, app: true },
    { k: "freenow", n: "FREE NOW", c: "#c8102e", href: FREENOW, app: true },
  ];
  const pre = [];
  if (r.wt) pre.push({ n: "World Transfer", lo: 66, hi: 72, txt: r.wt, note: { de: "laut Anbieter", ru: "по данным компании", en: "per provider" }[lang], href: LINKS.wt });
  if (r.welcome) pre.push({ n: "Welcome Pickups", lo: r.welcome.day, hi: r.welcome.night, txt: `${eur(r.welcome.day)} / ${eur(r.welcome.night)}`, note: { de: "tagsüber / nachts, laut Anbieter", ru: "днём / ночью, по данным компании", en: "day / night, per provider" }[lang], href: LINKS.welcome });
  pre.sort((a, b) => a.lo - b.lo);
  const known = apps.filter((a) => a.price).sort((a, b) => a.price - b.price);
  const cheapApp = known[0];
  const bestIsApp = cheapApp && cheapApp.price < r.fix;
  // Порядок: сначала самый дешёвый, потом остальные с ценой, потом «цена в приложении»
  const sortedApps = [...known, ...apps.filter((a) => !a.price)];
  return { ...r, fromN: PNAME[r.from][lang], toN: PNAME[r.to][lang], apps: sortedApps, pre, bestIsApp, cheapApp, airport: r.from === "air" || r.to === "air" };
});
const ownMeter = meter(8, 10);
const P = Object.fromEntries(Object.entries(PLACES).map(([k, v]) => [k, [v.lat, v.lng]]));
const R1 = routes[0];
---
<Base lang={lang} title={T.title} description={T.desc}>
  <Fragment slot="header">
    <div class="cmp-hero">
      <h1>{T.h1}</h1>
      <p>{T.lead}</p>
    </div>
  </Fragment>

  <div class="cmp">
    <section class="cmp-step" aria-labelledby="cmp-where">
      <div class="cmp-head">
        <h2 id="cmp-where">{T.where}</h2>
        <button type="button" class="cmp-gps" id="cmp-gps"><span aria-hidden="true">◎</span> {T.gps}</button>
      </div>
      <p class="cmp-msg" id="cmp-msg" hidden></p>
      <div class="cmp-routes" role="radiogroup" aria-labelledby="cmp-where">
        {routes.map((r, i) => (
          <button type="button" role="radio" class="cmp-route" data-route={r.id} data-from={r.from} aria-checked={i === 0 ? "true" : "false"}>
            <span class="cmp-route-a">{r.fromN}</span>
            <span class="cmp-route-b">→ {r.toN}</span>
            <span class="cmp-route-p">{lang === "ru" ? "Такси" : "Taxi"}: {eur(r.fix)}</span>
          </button>
        ))}
        <button type="button" role="radio" class="cmp-route cmp-route-own" data-route="own" aria-checked="false">
          <span class="cmp-route-a">{T.ownH}</span>
          <span class="cmp-route-b">{T.km}</span>
        </button>
      </div>
    </section>

    {routes.map((r, i) => (
      <section class="cmp-res" data-panel={r.id} hidden={i !== 0} aria-live="polite">
        <div class="cmp-tabs" role="tablist">
          <button type="button" role="tab" class="cmp-tab" data-tab="now" aria-selected="true">{T.now}</button>
          <button type="button" role="tab" class="cmp-tab" data-tab="pre" aria-selected="false">{T.pre}{r.pre.length > 0 && <span class="cmp-tab-from"> · {lang === "en" ? "from" : lang === "de" ? "ab" : "от"} {eur(r.pre[0].lo)}</span>}</button>
        </div>

        <div class="cmp-list" data-list="now">
          {r.bestIsApp && (
            <a class="cmp-row cmp-best" href={r.cheapApp.href} rel="noopener">
              <span class="cmp-best-tag">★ {T.best}</span>
              <span class="cmp-logo" style={`background:${r.cheapApp.c}`}>{r.cheapApp.n[0]}</span>
              <span class="cmp-name"><strong>{r.cheapApp.n}</strong><small>{r.cheapApp.note} · {T.vs(eur(r.fix - r.cheapApp.price))}</small></span>
              <span class="cmp-price">≈ {eur(r.cheapApp.price)}</span>
              <span class="cmp-go">{T.open} ›</span>
            </a>
          )}
          <div class={`cmp-fix${r.bestIsApp ? "" : " cmp-best"}`}>
            {!r.bestIsApp && <span class="cmp-best-tag">★ {T.best}</span>}
            <span class="cmp-logo cmp-logo-taxi">TAXI</span>
            <span class="cmp-name"><strong>{T.fixH}</strong><small>{T.fixNote}</small></span>
            <span class="cmp-price">{eur(r.fix)}</span>
          </div>
          <h3 class="cmp-sub">{T.appsH}</h3>
          {r.apps.filter((a) => !(r.bestIsApp && a === r.cheapApp)).map((a) => (
            <a class="cmp-row" href={a.href} rel="noopener">
              <span class="cmp-logo" style={`background:${a.c}`}>{a.n[0]}</span>
              <span class="cmp-name"><strong>{a.n}</strong>{a.note && <small>{a.note}</small>}</span>
              <span class={`cmp-price${a.price ? "" : " cmp-price-app"}`}>{a.price ? `≈ ${eur(a.price)}` : T.inApp}</span>
              <span class="cmp-go">{T.open} ›</span>
            </a>
          ))}
          {r.airport && <p class="cmp-hint">{T.sbahn}</p>}
        </div>

        <div class="cmp-list" data-list="pre" hidden>
          <p class="cmp-hint">{T.preNote}</p>
          {r.pre.length === 0 && <p class="cmp-hint">{T.preEmpty}</p>}
          {r.pre.map((p, j) => (
            <a class={`cmp-row${j === 0 ? " cmp-best" : ""}`} href={p.href} rel="noopener">
              {j === 0 && <span class="cmp-best-tag">★ {T.best}</span>}
              <span class="cmp-logo" style="background:#3b4a63">{p.n[0]}</span>
              <span class="cmp-name"><strong>{p.n}</strong>{p.note && <small>{p.note}</small>}</span>
              <span class="cmp-price">{p.txt.replace(/ €/g, " €")}</span>
              <span class="cmp-go">{T.book} ›</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="cmp-res" data-panel="own" hidden>
      <label class="cmp-km"><span>{T.km}</span><input id="cmp-km" type="number" inputmode="decimal" min="1" max="150" step="1" value="8"></label>
      <div class="cmp-list">
        <div class="cmp-fix">
          <span class="cmp-logo cmp-logo-taxi">TAXI</span>
          <span class="cmp-name"><strong>{T.meterH}</strong><small id="cmp-meter-note">{T.meterNote(eur(ownMeter.lo), eur(ownMeter.hi))}</small></span>
          <span class="cmp-price" id="cmp-meter">{eur(ownMeter.lo)}–{eur(ownMeter.hi)}</span>
        </div>
        <h3 class="cmp-sub">{T.appsH}</h3>
        <a class="cmp-row" href={uberLink(null, null)} rel="noopener"><span class="cmp-logo" style="background:#111">U</span><span class="cmp-name"><strong>Uber</strong><small>{T.uberNote}</small></span><span class="cmp-price cmp-price-app">{T.inApp}</span><span class="cmp-go">{T.open} ›</span></a>
        <a class="cmp-row" href={BOLT} rel="noopener"><span class="cmp-logo" style="background:#2a9d5c">B</span><span class="cmp-name"><strong>Bolt</strong></span><span class="cmp-price cmp-price-app">{T.inApp}</span><span class="cmp-go">{T.open} ›</span></a>
        <a class="cmp-row" href={FREENOW} rel="noopener"><span class="cmp-logo" style="background:#c8102e">F</span><span class="cmp-name"><strong>FREE NOW</strong></span><span class="cmp-price cmp-price-app">{T.inApp}</span><span class="cmp-go">{T.open} ›</span></a>
      </div>
    </section>

    <p class="cmp-stand">{T.stand}</p>

    <section class="cmp-tips" aria-labelledby="cmp-tips-h">
      <h2 id="cmp-tips-h">{T.tipsH}</h2>
      <p class="cmp-author">{T.author}</p>
      <ol>{T.tips.map((x) => <li>{x}</li>)}</ol>
    </section>

    <nav class="cmp-more" aria-label={T.more}>
      <a href={`${base}/${lang}/munich/`}><strong>{T.moreCity[0]}</strong><span>{T.moreCity[1]}</span></a>
      <a href={`${base}/${lang}/countries/`}><strong>{T.moreCountries[0]}</strong><span>{T.moreCountries[1]}</span></a>
    </nav>
  </div>

  <script is:inline define:vars={{ P, TARIFF: { base: TARIFF.base, tiers: TARIFF.tiers.map(([u, r]) => [u === Infinity ? 1e9 : u, r]), perMin: TARIFF.perMin }, loc, MSG: { no: T.gpsNo, far: T.gpsFar }, NOTE: T.meterNote("{lo}", "{hi}") }}>
    (function () {
      var q = function (s, el) { return (el || document).querySelector(s); }, qa = function (s, el) { return Array.prototype.slice.call((el || document).querySelectorAll(s)); };
      var eur = function (n) { return Math.round(n).toLocaleString(loc) + " €"; };
      function pick(id) {
        qa(".cmp-route").forEach(function (b) { b.setAttribute("aria-checked", b.dataset.route === id ? "true" : "false"); });
        qa(".cmp-res").forEach(function (s) { s.hidden = s.dataset.panel !== id; });
        var p = q('.cmp-res[data-panel="' + id + '"]'); if (p && window.innerWidth < 700) p.scrollIntoView({ behavior: "smooth", block: "start" });
      }
      qa(".cmp-route").forEach(function (b) { b.addEventListener("click", function () { pick(b.dataset.route); }); });
      qa(".cmp-res").forEach(function (s) {
        qa(".cmp-tab", s).forEach(function (t) {
          t.addEventListener("click", function () {
            qa(".cmp-tab", s).forEach(function (x) { x.setAttribute("aria-selected", x === t ? "true" : "false"); });
            qa("[data-list]", s).forEach(function (l) { l.hidden = l.dataset.list !== t.dataset.tab; });
          });
        });
      });
      // Счётчик для своего маршрута
      var note = function (lo, hi) { return NOTE.replace("{lo}", lo).replace("{hi}", hi); };
      function meter(km) {
        var left = km, prev = 0, d = TARIFF.base;
        for (var i = 0; i < TARIFF.tiers.length && left > 0; i++) { var seg = Math.min(left, TARIFF.tiers[i][0] - prev); d += seg * TARIFF.tiers[i][1]; left -= seg; prev = TARIFF.tiers[i][0]; }
        var min = Math.max(5, km * 1.25); return [d, d + min * TARIFF.perMin];
      }
      var km = q("#cmp-km");
      if (km) km.addEventListener("input", function () {
        var v = Math.min(Math.max(parseFloat(km.value) || 0, 0), 150); if (!v) return;
        var m = meter(v); q("#cmp-meter").textContent = eur(m[0]) + "–" + eur(m[1]);
        q("#cmp-meter-note").textContent = note(eur(m[0]), eur(m[1]));
      });
      // Где я: если рядом с аэропортом, вокзалом или Messe — выбираем маршрут оттуда
      var gps = q("#cmp-gps"), msg = q("#cmp-msg");
      function say(t) { msg.textContent = t; msg.hidden = false; }
      if (!navigator.geolocation) gps.hidden = true;
      gps.addEventListener("click", function () {
        navigator.geolocation.getCurrentPosition(function (pos) {
          var c = pos.coords, best = null, bd = 1e9;
          Object.keys(P).forEach(function (k) {
            var dLat = (P[k][0] - c.latitude) * 111, dLng = (P[k][1] - c.longitude) * 111 * Math.cos(c.latitude * Math.PI / 180), d = Math.sqrt(dLat * dLat + dLng * dLng);
            if (d < bd) { bd = d; best = k; }
          });
          if (bd > 2.5) { say(MSG.far); pick("own"); return; }
          msg.hidden = true;
          var b = q('.cmp-route[data-from="' + best + '"]'); if (b) pick(b.dataset.route);
        }, function () { say(MSG.no); }, { timeout: 8000, maximumAge: 60000 });
      });
    })();
  </script>
</Base>

<style is:global>
  .cmp-hero h1{font:800 clamp(26px,7vw,34px)/1.12 var(--f-display);letter-spacing:-.02em;margin:6px 0 6px}
  .cmp-hero p{margin:0;color:var(--muted);font-size:15px}
  .cmp{display:flex;flex-direction:column;gap:18px}
  .cmp h2{font:800 19px/1.2 var(--f-display);margin:0}
  .cmp-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}
  .cmp-gps{border:1px solid var(--line-strong);background:var(--surface);color:var(--fg);border-radius:999px;padding:8px 12px;font:600 13px var(--f-body);cursor:pointer;min-height:38px;white-space:nowrap}
  .cmp-gps:hover{border-color:var(--fg)}
  .cmp-msg{margin:0 0 10px;font-size:14px;color:var(--warn)}
