---
import Base from "../../layouts/Base.astro";
import { LANGS, SOURCES, COMPANIES, PHOTOS, REVIEW_COUNTRIES, FEATURES, ROUTES } from "../../lib/data.js";
import { L } from "../../lib/texts.js";
import { routesHTML, meterHTML, actionsHTML, tiersHTML, opsHTML, reviewsHTML, whenHTML, esc, nb, heroTitle } from "../../lib/render.js";
import { W, RV, PHOTO } from "../../lib/texts.js";
import { CITIES, GL } from "../../lib/germany.js";
import Tips from "../../components/Tips.astro";
import { SLOGAN, SEC, readySections } from "../../lib/city.js";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const t = L[lang];
const r = RV[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const img = (k, cls = "photo", eager = false) => { const p = PHOTOS[k]; return `<figure class="${cls}"><img src="${base}/${p.src}" alt="${p.alt[lang]}" width="1280" height="853" ${eager ? 'fetchpriority="high"' : 'loading="lazy"'} decoding="async"><figcaption>${PHOTO[lang].credit}: <a href="${p.url}" rel="noopener">${p.by}</a>, ${p.lic}</figcaption></figure>`; };
const st = { lang, routeId: "air-hbf", km: 8, min: 10, to: "Marienplatz", reviews: [] };
const META = {
  ru: ["Такси из аэропорта Мюнхена: цена, Uber, Bolt, трансфер | TaxiCheck", "Сколько стоит такси из аэропорта Мюнхена в центр: фиксированная цена 96 €, Uber, Bolt, трансферы и премиум. Проверка цены водителя и советы таксиста."],
  de: ["Taxi Flughafen München: Preis, Uber, Bolt, Transfer im Vergleich | TaxiCheck", "Was kostet das Taxi vom Flughafen München ins Zentrum: Festpreis 96 €, Uber, Bolt, Transfers und Premium. Preis-Check und Tipps vom Taxifahrer."],
  en: ["Munich Airport taxi price vs Uber, Bolt & transfers | TaxiCheck", "What a taxi from Munich Airport to the centre costs: fixed 96 €, Uber, Bolt, transfers and premium. Check a quoted fare and get tips from a cab driver."],
};
---
<Base lang={lang} title={META[lang][0]} description={META[lang][1]} credits={[PHOTOS.hero, PHOTOS.marienplatz]}>
  <Fragment slot="header">
    <figure class="photo hero hero-compact"><img src={`${base}/${PHOTOS.hero.src}`} alt={PHOTOS.hero.alt[lang]} width="1600" height="1200" style="object-position:50% 12%" fetchpriority="high" decoding="async"><div class="hero-text"><p class="kicker">{SLOGAN[lang]}</p><h1 id="hero-h1">{heroTitle(st)}</h1></div></figure>
  </Fragment>

  <div class="calc">
  <section class="stack" aria-label={t.h1}>
    <div class="routes" id="routes" set:html={routesHTML(st)} />
    <div class="own stack" id="own" hidden>
      <div><label for="to">{t.to}</label><input id="to" autocomplete="off" value="Marienplatz"></div>
      <div class="grid2">
        <div><label for="km">{t.km}</label><input id="km" type="number" inputmode="decimal" min="0.5" step="0.5" value="8"></div>
        <div><label for="wait">{t.wait}</label><input id="wait" type="number" inputmode="numeric" min="0" step="1" value="10"></div>
      </div>
      <p class="hint">{t.ownHint}</p>
    </div>
  </section>

  <section class="meter" id="meter" aria-live="polite" set:html={meterHTML(st)} />
  <section class="actions" id="actions" set:html={actionsHTML(st)} />
  <section class="check">
    <h2 id="h-check">{t.hCheck}</h2>
    <div class="note check-box">
      <p class="check-sub">{t.sCheck}</p>
      <div class="check-row">
        <input id="asked" type="number" inputmode="decimal" min="1" step="1" placeholder="€" aria-labelledby="h-check">
        <button class="btn taxi" type="button" id="b-check">{t.bCheck}</button>
      </div>
      <p class="verdict" id="verdict"></p>
    </div>
  </section>
  </div>



  <section>
    <h2>{t.hTiers}</h2>
    <p class="sub">{t.sTiers}</p>
    <div class="tiers" id="tiers" set:html={tiersHTML(st)} />
  </section>

  <a class="teaser" href={`${base}/${lang}/munich/`}>
    <img src={`${base}/${PHOTOS.marienplatz.src}`} alt={PHOTOS.marienplatz.alt[lang]} width="1280" height="853" loading="lazy" decoding="async">
    <span class="teaser-b"><strong>{SEC[lang].cityTeaser}</strong><span>{SEC[lang].cityTeaserTxt}</span><span class="teaser-chips">{readySections("munich").slice(1).map((k) => <em>{SEC[lang].nav[k]}</em>)}</span><span class="teaser-go">{SEC[lang].open} →</span></span>
  </a>

  <section id="when">
    <details class="fold">
      <summary><h2>{W[lang].head}</h2><span class="fold-sub">{W[lang].sub}</span></summary>
      <div class="tw" set:html={whenHTML(st)} />
    </details>
  </section>

  <section class="cheat" id="cheat-sheet">
    <h2>{t.hCheat}</h2>
    <p class="sub">{t.sCheat}</p>
    <div class="card cheat-box">
      <ol>{t.cheat.map((x) => <li>{nb(x)}</li>)}</ol>
      <button class="btn" type="button" id="b-share">{t.bShare}</button>
      <p class="toast" id="share-toast"></p>
    </div>
  </section>

  <section>
    <h2>{t.hOp}</h2>
    <Fragment set:html={img("taxis")} />
    <div class="author"><div class="badge">{t.badge}</div><p>{t.authorTxt}</p></div>
    <div class="ops" id="ops" set:html={opsHTML(st)} />
    <p class="disclaim">{t.disclaim}</p>
  </section>

  <section id="journal" hidden={!FEATURES.journal}>
    <details class="fold">
    <summary><h2>{t.hJr}</h2><span class="fold-sub">{t.sJr}</span></summary>
    <div class="tw"><table class="journal">
      <thead><tr>{t.jr.map((h) => <th>{h}</th>)}</tr></thead>
      <tbody><tr>{t.jr.map((_, i) => <td>{i === 0 ? t.jrEmpty : "—"}</td>)}</tr></tbody>
    </table></div>
    </details>
  </section>

  <section id="how">
    <details class="fold">
    <summary><h2>{t.hHow}</h2><span class="fold-sub">{t.sumCalc} · {t.sumSrc} · {t.sumAds}</span></summary>
    <div class="fold-body">
      <h3>{t.sumCalc}</h3><ul>{t.calc.map((x) => <li>{x}</li>)}</ul>
      <h3>{t.sumSrc}</h3><ul>{SOURCES.map(([n, u, d]) => <li>{u ? <a href={u} rel="noopener">{n}</a> : n} · {d}</li>)}{Object.values(PHOTOS).map((p) => <li>{PHOTO[lang].credit}: <a href={p.url} rel="noopener">{p.alt[lang]}</a> · {p.by} · {p.lic} (Wikimedia Commons)</li>)}</ul>
      <h3>{t.sumAds}</h3><ul>{t.ads.map((x) => <li>{x}</li>)}</ul>
    </div>
    </details>
  </section>

  <section id="germany">
    <details class="fold">
    <summary><h2>{GL[lang].title}</h2><span class="fold-sub">{GL[lang].sub(CITIES.length)}</span></summary>
    <div class="fold-body">
    <Fragment set:html={img("siegestor")} />
    <input id="city-q" type="search" placeholder={GL[lang].search} aria-label={GL[lang].search} style="margin-bottom:10px">
    <div class="tw"><table class="journal cities">
      <thead><tr>{GL[lang].cols.map((c) => <th>{c}</th>)}</tr></thead>
      <tbody>{CITIES.map((c) => <tr data-city={c.n.toLowerCase()}>
        <td>{c.n}{c.full && <span class="full">{GL[lang].full}</span>}</td>
        {[c.taxi, c.taxifix, c.uber, c.bolt, c.freenow].map((v) => <td class={v ? "yes" : "unk"}>{v ? GL[lang].yes : GL[lang].unk}</td>)}
      </tr>)}</tbody>
    </table></div>
    <p class="hint" id="city-empty" hidden>{GL[lang].empty}</p>
    <p class="hint">{GL[lang].unkNote}</p>
    </div>
    </details>
  </section>

  {FEATURES.tips && <Tips lang={lang} scope="de-muenchen" where="München" />}

  <section id="reviews-sec" hidden={!FEATURES.reviews}>
    <h2>{r.head}</h2>
    <p class="sub">{r.sub}</p>
    <p class="hint">{r.note}</p>
    <div id="reviews" set:html={reviewsHTML(st)} />
    <form id="form" class="stack" novalidate style="margin-top:16px">
      <div class="grid2">
        <div><label for="country">{r.country}</label><select id="country">{REVIEW_COUNTRIES.map(([k, n]) => <option value={k}>{n ? n[lang] : r.other}</option>)}</select></div>
        <div><label for="city">{r.city}</label><input id="city" autocomplete="off" placeholder={r.cityPh}></div>
      </div>
      <div><label for="company">{r.company}</label><input id="company" list="companies" autocomplete="off" placeholder={r.companyPh}><datalist id="companies">{COMPANIES.map((c) => <option value={c} />)}</datalist></div>
      <fieldset class="kind"><legend>{r.kind}</legend>
        <label><input type="radio" name="kind" value="fresh" checked> {r.fresh}</label>
        <label><input type="radio" name="kind" value="long"> {r.long}</label>
      </fieldset>
      <div><label>{t.service}</label><div class="stars" data-for="service"></div></div>
      <div><label>{t.value}</label><div class="stars" data-for="value"></div></div>
      <div><label for="text">{t.text}</label><textarea id="text" rows="3" placeholder={t.ph}></textarea></div>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap"><button class="btn taxi" type="submit" style="min-width:200px">{t.send}</button><p class="toast" id="toast"></p></div>
    </form>
  </section>

  <p slot="footer">{t.foot}</p>
</Base>

<script>
  import { L, RV } from "../../lib/texts.js";
  import { PHONES } from "../../lib/data.js";
  import { routesHTML, meterHTML, actionsHTML, tiersHTML, opsHTML, reviewsHTML, verdict, heroTitle } from "../../lib/render.js";

  const $ = (id) => document.getElementById(id);
  const lang = document.documentElement.lang;
  const t = L[lang];
  const store = { get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }, set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} } };
  let reviews = []; try { reviews = JSON.parse(store.get("taxicheck-reviews") || "[]"); } catch (e) {}
  const st = { lang, routeId: "air-hbf", km: 8, min: 10, to: "Marienplatz", reviews };

  function readInputs() { st.km = parseFloat($("km").value) || 0; st.min = parseFloat($("wait").value) || 0; st.to = $("to").value; }
  function render() {
    readInputs();
    $("routes").innerHTML = routesHTML(st);
    $("own").hidden = st.routeId !== "own";
    $("meter").innerHTML = meterHTML(st);
    $("actions").innerHTML = actionsHTML(st);
    $("tiers").innerHTML = tiersHTML(st);
    $("hero-h1").textContent = heroTitle(st);
  }
  function renderRatings() { $("ops").innerHTML = opsHTML(st); $("reviews").innerHTML = reviewsHTML(st); $("tiers").innerHTML = tiersHTML(st); }

  $("routes").addEventListener("click", (e) => { const b = e.target.closest("[data-r]"); if (!b) return; st.routeId = b.dataset.r; $("verdict").textContent = ""; render(); });
  ["km", "wait", "to"].forEach((id) => $(id).addEventListener("input", render));
  function check() { const [cls, msg] = verdict(st, parseFloat($("asked").value)); const v = $("verdict"); v.className = "verdict " + cls; v.textContent = msg; }
  $("b-check").addEventListener("click", check);
  $("asked").addEventListener("keydown", (e) => { if (e.key === "Enter") check(); });

  function copyText(text, ok, fail) { try { navigator.clipboard.writeText(text).then(ok, fail); } catch (e) { fail(); } }
  $("actions").addEventListener("click", (e) => {
    const b = e.target.closest("[data-copy]"); if (!b) return;
    copyText(PHONES[+b.dataset.copy][1], () => { b.classList.add("ok"); b.title = t.copied; setTimeout(() => { b.classList.remove("ok"); b.title = t.copy; }, 1500); }, () => {});
  });
  $("b-share").addEventListener("click", async () => {
    const txt = `TaxiCheck · ${t.hCheat}\n` + t.cheat.map((x, i) => `${i + 1}. ${x}`).join("\n") + `\n${location.href}`;
    if (navigator.share) { try { await navigator.share({ title: "TaxiCheck", text: txt }); return; } catch (e) {} }
    copyText(txt, () => ($("share-toast").textContent = t.shareOk), () => ($("share-toast").textContent = t.shareFail));
  });

  const score = { service: 0, value: 0 };
  document.querySelectorAll(".stars").forEach((box) => {
    const k = box.dataset.for;
    box.innerHTML = [1, 2, 3, 4, 5].map((n) => `<button type="button" class="star" data-n="${n}" aria-label="${n}/5">★</button>`).join("");
    box.addEventListener("click", (e) => { const b = e.target.closest(".star"); if (!b) return; score[k] = +b.dataset.n; [...box.children].forEach((s) => s.classList.toggle("on", +s.dataset.n <= score[k])); });
  });
  $("form").addEventListener("submit", (e) => {
    e.preventDefault(); const txt = $("text").value.trim(), m = $("toast");
    if (!score.service || !score.value) { m.style.color = "var(--warn)"; m.textContent = t.errStars; return; }
    const comp = $("company").value.trim();
    if (comp.length < 2) { m.style.color = "var(--warn)"; m.textContent = RV[lang].errCompany; return; }
    if (txt.length < 5) { m.style.color = "var(--warn)"; m.textContent = t.errText; return; }
    const kind = (document.querySelector('input[name="kind"]:checked') || {}).value || "fresh";
    reviews.push({ c: comp, co: $("country").value, ci: $("city").value.trim().slice(0, 60), k: kind, s: score.service, v: score.value, t: txt.slice(0, 1000), d: new Date().toISOString().slice(0, 10) });
    store.set("taxicheck-reviews", JSON.stringify(reviews));
    score.service = score.value = 0; $("text").value = ""; $("company").value = ""; document.querySelectorAll(".star").forEach((s) => s.classList.remove("on"));
    renderRatings(); m.style.color = "var(--good)"; m.textContent = t.ok;
  });
  renderRatings();
  const openHash = () => { const el = location.hash && document.querySelector(location.hash); const d = el && (el.matches("details") ? el : el.querySelector("details.fold")); if (d) d.open = true; };
  openHash(); window.addEventListener("hashchange", openHash);
  const q = $("city-q");
  q.addEventListener("input", () => {
    const v = q.value.trim().toLowerCase(); let n = 0;
    document.querySelectorAll("tr[data-city]").forEach((tr) => { const on = !v || tr.dataset.city.includes(v); tr.hidden = !on; if (on) n++; });
    $("city-empty").hidden = n > 0;
  });
</script>
