---
// Главная: как в Google Maps. Маршрут на карте → строка фирм → классы машин с ценой, от дешёвого к дорогому.
// Такси — точная цена (фикс или тариф). Приложения — только оценка-диапазон: их цены динамические.
// Оценка = доля от тарифа такси на те же км; доли взяты из средних цен Uber аэропорт → центр (11.2026).
// Всё требует проверки. Живые цены — только в приложении (кнопка «Открыть»).
import Base from "../../layouts/Base.astro";
import { LANGS, ROUTES, PLACES, LINKS, TARIFF } from "../../lib/data.js";

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const loc = lang === "ru" ? "ru-RU" : lang === "de" ? "de-DE" : "en-GB";

const T = {
  de: {
    title: "Taxi, Uber, Bolt oder FREE NOW – was ist in München günstiger? | TaxiCheck",
    desc: "Strecke wählen und alle Anbieter und Fahrzeugklassen sehen: Taxi-Festpreis, Uber, Bolt, FREE NOW, Transfer – vom günstigsten zum teuersten.",
    h1: "Taxi, Uber, Bolt oder FREE NOW – was ist günstiger?",
    lead: "München · Strecke wählen – alle Anbieter und Klassen sehen – App öffnen.",
    from: "Von", to: "Nach", gps: "Mein Standort", gpsNo: "Standort nicht verfügbar – bitte Strecke wählen.", gpsFar: "Sie sind nicht direkt an Flughafen, Hbf oder Messe – geben Sie unten die Entfernung ein.",
    own: "Andere Strecke", km: "Entfernung", gmaps: "Route in Google Maps",
    all: "Alle", transfer: "Transfer",
    cheapest: "Günstigste", priciest: "Teuerste", likely: "Wahrscheinlich günstigste",
    seats: (n) => `${n} Pers.`, fix: "Festpreis", meterT: "Taxameter", est: "Schätzung", avg: "Ø laut Uber", pre: "nur vorab",
    open: "Öffnen", taxiGo: "Am Taxistand",
    fixNote: "Festpreis – am Taxistand und per Taxi-App, ohne Taxameter.",
    meterNote: "nach Taxameter, ohne und mit Stau",
    estNote: "Apps haben keine festen Preise: sie ändern sich mehrmals am Tag. Angezeigt ist eine Schätzung – den echten Preis zeigt die App.",
    appTaxi: "Taxi-Tarif, App kann Gebühr aufschlagen",
    count: (n) => `${n} Optionen · günstig → teuer`,
    sbahn: "Ohne Taxi: S-Bahn ins Zentrum 11,60 € (ca. 40 Min.).",
    tipsH: "Tipps aus der Praxis", author: "Von einem Vielreisenden, der das Geschäft von beiden Seiten kennt – vom Fahrersitz und von der Rückbank.",
    tips: ["Vor dem Einsteigen nach dem Preis fragen. Auf Festpreis-Strecken gilt der Festpreis – nicht mehr.", "Apps zur selben Minute vergleichen: bei Regen, Messe und Wiesn springen die Preise.", "Zeigt Uber oder Bolt mehr als den Taxi-Festpreis, nehmen Sie das Taxi."],
    stand: "Taxi: Tarif und Festpreise der Stadt München, Stand " + TARIFF.date + ". Apps: Schätzung aus Uber-Durchschnittspreisen Flughafen → City (11/2026), für Bolt und FREE NOW ohne eigene Daten. Alles unverbindlich, ohne Gewähr. TaxiCheck ist mit den Anbietern nicht verbunden.",
    more: "Mehr", moreCity: ["München-Guide", "Sehenswertes, Essen, Events"], moreCountries: ["Taxi-Tipps nach Ländern", "9 Länder"],
  },
  ru: {
    title: "Такси, Uber, Bolt или FREE NOW — что дешевле в Мюнхене? | TaxiCheck",
    desc: "Выберите маршрут и увидите все сервисы и классы машин: фикс-цена такси, Uber, Bolt, FREE NOW, трансфер — от дешёвого к дорогому.",
    h1: "Такси, Uber, Bolt или FREE NOW — что дешевле?",
    lead: "Мюнхен · выберите маршрут — увидите все сервисы и классы — откройте приложение.",
    from: "Откуда", to: "Куда", gps: "Где я", gpsNo: "Местоположение недоступно — выберите маршрут.", gpsFar: "Вы не у аэропорта, вокзала или Messe — введите расстояние ниже.",
    own: "Другой маршрут", km: "Расстояние", gmaps: "Маршрут в Google Maps",
    all: "Все", transfer: "Трансфер",
    cheapest: "Самый дешёвый", priciest: "Самый дорогой", likely: "Скорее всего дешевле всех",
    seats: (n) => `до ${n} чел.`, fix: "фикс-цена", meterT: "по счётчику", est: "оценка", avg: "в среднем по Uber", pre: "только заранее",
    open: "Открыть", taxiGo: "На стоянке",
    fixNote: "Фиксированная цена — на стоянке и через приложение такси, без счётчика.",
    meterNote: "по счётчику, без пробок и с пробками",
    estNote: "У приложений нет фиксированных цен: они меняются несколько раз в день. Здесь оценка — точную цену покажет приложение.",
    appTaxi: "тариф такси, приложение может добавить сбор",
    count: (n) => `${n} вариантов · от дешёвого к дорогому`,
    sbahn: "Без такси: S-Bahn в центр 11,60 € (около 40 мин).",
    tipsH: "Советы из практики", author: "От человека, который много ездил по миру и знает такси с обеих сторон — за рулём и на заднем сиденье.",
    tips: ["Спросите цену до посадки. Где действует фиксированная цена — платите её, не больше.", "Сравнивайте приложения в одну и ту же минуту: в дождь, на выставках и в Октоберфест цены прыгают.", "Если Uber или Bolt показывают больше фикс-цены такси — берите такси."],
    stand: "Такси: тариф и фикс-цены города Мюнхена от " + TARIFF.date + ". Приложения: оценка по средним ценам Uber аэропорт → центр (11.2026), для Bolt и FREE NOW своих данных нет. Всё ориентировочно, без гарантии. TaxiCheck не связан с этими сервисами.",
    more: "Ещё", moreCity: ["Мюнхен: гид", "что посмотреть, еда, события"], moreCountries: ["Такси в других странах", "9 стран"],
  },
  en: {
    title: "Taxi, Uber, Bolt or FREE NOW – what's cheaper in Munich? | TaxiCheck",
    desc: "Pick a route and see every provider and car class: taxi fixed fare, Uber, Bolt, FREE NOW, transfer – cheapest to most expensive.",
    h1: "Taxi, Uber, Bolt or FREE NOW – what's cheaper?",
    lead: "Munich · pick a route – see all providers and classes – open the app.",
    from: "From", to: "To", gps: "My location", gpsNo: "Location unavailable – please pick a route.", gpsFar: "You're not right at the airport, Hbf or Messe – enter the distance below.",
    own: "Other route", km: "Distance", gmaps: "Route in Google Maps",
    all: "All", transfer: "Transfer",
    cheapest: "Cheapest", priciest: "Most expensive", likely: "Likely cheapest",
    seats: (n) => `${n} seats`, fix: "fixed fare", meterT: "meter", est: "estimate", avg: "avg. per Uber", pre: "book ahead",
    open: "Open", taxiGo: "At the rank",
    fixNote: "Fixed fare – at the taxi rank and via taxi apps, no meter.",
    meterNote: "by meter, without and with traffic",
    estNote: "Apps have no fixed prices: they change several times a day. Shown is an estimate – the app shows the real price.",
    appTaxi: "taxi tariff, the app may add a fee",
    count: (n) => `${n} options · cheapest → priciest`,
    sbahn: "Without a taxi: S-Bahn to the centre 11.60 € (about 40 min).",
    tipsH: "Tips from practice", author: "From a seasoned traveller who knows the trade from both sides – behind the wheel and in the back seat.",
    tips: ["Ask the price before you get in. On fixed-fare routes the fixed fare applies – no more.", "Compare apps at the same minute: prices jump in rain, trade fairs and Oktoberfest.", "If Uber or Bolt shows more than the taxi fixed fare, take the taxi."],
    stand: "Taxi: City of Munich tariff and fixed fares as of " + TARIFF.date + ". Apps: estimate from Uber average prices airport → city (11/2026); no own data for Bolt and FREE NOW. All non-binding, no guarantee. TaxiCheck is not affiliated with the providers.",
    more: "More", moreCity: ["Munich guide", "sights, food, events"], moreCountries: ["Taxi tips by country", "9 countries"],
  },
}[lang];

const PNAME = {
  air: { de: "Flughafen", ru: "Аэропорт", en: "Airport" },
  hbf: { de: "Hauptbahnhof", ru: "Главный вокзал", en: "Central Station" },
  messe: { de: "Messe", ru: "Messe", en: "Messe" },
};
const routes = ROUTES.filter((r) => r.id !== "own").map((r) => ({ id: r.id, from: r.from, to: r.to, km: r.km, fix: r.fix, uber: r.uber || null, wt: r.wt ? [66, 72] : null, welcome: r.welcome ? [60, 79] : null, fromN: PNAME[r.from][lang], toN: PNAME[r.to][lang] }));

// Карта: простая схема Мюнхена без чужих серверов (никаких cookies и трекинга)
const proj = (p) => [Math.round(((p.lng - 11.5) / 0.32) * 340 + 10), Math.round(((48.38 - p.lat) / 0.28) * 200 + 10)];
const XY = Object.fromEntries(Object.entries(PLACES).map(([k, v]) => [k, proj(v)]));
const PL = Object.fromEntries(Object.entries(PLACES).map(([k, v]) => [k, { lat: v.lat, lng: v.lng, n: v.n }]));
const LINK = { bolt: lang === "de" ? "https://bolt.eu/de-de/rides/" : "https://bolt.eu/en-de/rides/", freenow: LINKS.freenow, wt: LINKS.wt, welcome: LINKS.welcome };
const TARIF = { base: TARIFF.base, tiers: TARIFF.tiers.map(([u, r]) => [u === Infinity ? 1e9 : u, r]), perMin: TARIFF.perMin };
const TXT = { ...T, seats: [T.seats(4), T.seats(6), T.seats(8)], count: T.count("{n}") };
delete TXT.tips; delete TXT.title; delete TXT.desc;
---
<Base lang={lang} title={T.title} description={T.desc}>
  <Fragment slot="header">
    <div class="cmp-hero"><h1>{T.h1}</h1><p>{T.lead}</p></div>
  </Fragment>

  <div class="cmp" id="cmp">
    <section class="cmp-card cmp-mapcard" aria-label={T.gmaps}>
      <svg class="cmp-map" viewBox="0 0 360 220" role="img" aria-label="München">
        <rect width="360" height="220" class="m-bg" />
        <path class="m-water" d="M150 0 C 140 50, 175 90, 150 130 S 120 190, 135 220" />
        <path class="m-road" d="M70 190 C 120 150, 200 120, 300 40" />
        <path class="m-road" d="M20 120 C 120 125, 220 140, 350 150" />
        <ellipse class="m-city" cx="95" cy="178" rx="70" ry="34" />
        <text class="m-label" x="40" y="214">München</text>
        <path id="m-route" class="m-route" d="" />
        {Object.entries(XY).map(([k, [x, y]]) => (
          <g class="m-pt" data-pt={k}><circle cx={x} cy={y} r="6" /><text x={k === "air" ? x - 11 : x + 9} y={k === "air" ? y + 4 : y - 9} text-anchor={k === "air" ? "end" : "start"}>{PNAME[k][lang]}</text></g>
        ))}
      </svg>
      <div class="cmp-ft">
        <div class="cmp-ft-row"><span class="dot dot-a"></span><span class="cmp-ft-l">{T.from}</span><strong id="cmp-from">{routes[0].fromN}</strong></div>
        <div class="cmp-ft-row"><span class="dot dot-b"></span><span class="cmp-ft-l">{T.to}</span><strong id="cmp-to">{routes[0].toN}</strong></div>
        <button type="button" class="cmp-gps" id="cmp-gps">◎ {T.gps}</button>
      </div>
      <p class="cmp-msg" id="cmp-msg" hidden></p>
      <div class="cmp-routes" role="radiogroup" aria-label={T.to}>
        {routes.map((r, i) => <button type="button" role="radio" class="cmp-route" data-route={r.id} aria-checked={i === 0 ? "true" : "false"}>{r.fromN} → {r.toN}</button>)}
        <button type="button" role="radio" class="cmp-route" data-route="own" aria-checked="false">{T.own}</button>
      </div>
      <label class="cmp-km" id="cmp-kmbox" hidden><span>{T.km}</span><span class="cmp-km-in"><input id="cmp-km" type="number" inputmode="decimal" min="1" max="150" step="1" value="8"> km</span></label>
      <a class="cmp-gmaps" id="cmp-gmaps" href="#" rel="noopener">↗ {T.gmaps}</a>
    </section>

    <section class="cmp-card cmp-res" aria-live="polite">
      <div class="cmp-prov" role="tablist" id="cmp-prov">
        {[["all", T.all], ["taxi", "Taxi"], ["uber", "Uber"], ["bolt", "Bolt"], ["freenow", "FREE NOW"], ["transfer", T.transfer]].map(([k, n], i) => (
          <button type="button" role="tab" class="cmp-pv" data-prov={k} aria-selected={i === 0 ? "true" : "false"}>{k !== "all" && <span class={`pv-dot pv-${k}`}></span>}{n}</button>
        ))}
      </div>
      <p class="cmp-count" id="cmp-count"></p>
      <div class="cmp-list" id="cmp-list"><noscript><p class="cmp-hint">{T.fixNote}</p></noscript></div>
      <p class="cmp-hint" id="cmp-est">{T.estNote}</p>
      <p class="cmp-hint" id="cmp-sbahn">{T.sbahn}</p>
    </section>

    <p class="cmp-stand">{T.stand}</p>

    <section class="cmp-tips" aria-labelledby="cmp-tips-h">
      <h2 id="cmp-tips-h">{T.tipsH}</h2>
      <p class="cmp-author">{T.author}</p>
      <ol>{T.tips.map((x) => <li>{x}</li>)}</ol>
    </section>

    <nav class="cmp-more" aria-label={T.more}>
      <a href={`${base}/${lang}/munich/`}><strong>{T.moreCity[0]}</strong><span>{T.moreCity[1]}</span></a>
      <a href={`${base}/${lang}/countries/`}><strong>{T.moreCountries[0]}</strong><span>{T.moreCountries[1]}</span></a>
    </nav>
  </div>

  <script is:inline define:vars={{ ROUTES: routes, XY, PL, LINK, TARIF, TXT, loc }}>
  (function () {
    var $ = function (s) { return document.querySelector(s); }, $$ = function (s) { return Array.prototype.slice.call(document.querySelectorAll(s)); };
    var r5 = function (n) { return Math.max(5, Math.round(n / 5) * 5); };
    var eur = function (n) { return Math.round(n).toLocaleString(loc) + " €"; };
    var esc = function (s) { return String(s).replace(/[&<>"]/g, function (m) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[m]; }); };
    var st = { route: ROUTES[0].id, km: 8, prov: "all" };

    function meter(km) {
      var left = km, prev = 0, d = TARIF.base;
      for (var i = 0; i < TARIF.tiers.length && left > 0; i++) { var seg = Math.min(left, TARIF.tiers[i][0] - prev); d += seg * TARIF.tiers[i][1]; left -= seg; prev = TARIF.tiers[i][0]; }
      var min = Math.max(5, km * 1.25); return [d, d + min * TARIF.perMin];
    }
    function uberLink(f, t) {
      var q = "action=setPickup";
      q += f ? "&pickup[latitude]=" + f.lat + "&pickup[longitude]=" + f.lng + "&pickup[nickname]=" + encodeURIComponent(f.n) : "&pickup=my_location";
      if (t) q += "&dropoff[latitude]=" + t.lat + "&dropoff[longitude]=" + t.lng + "&dropoff[nickname]=" + encodeURIComponent(t.n);
      return "https://m.uber.com/ul/?" + q;
    }
    // Доли от тарифа такси (из средних Uber аэропорт → центр: X 70, Comfort 73, XL 104, Premium 127 при тарифе ~107 €)
    var K = { std: 0.65, comfort: 0.68, xl: 0.97, premium: 1.18 };

    function options() {
      var rt = ROUTES.filter(function (x) { return x.id === st.route; })[0];
      var own = !rt, km = own ? st.km : rt.km, m = meter(km), mid = (m[0] + m[1]) / 2;
      var f = own ? null : PL[rt.from], t = own ? null : PL[rt.to];
      var U = uberLink(f, t), list = [];
      var taxi = rt ? { lo: rt.fix, hi: rt.fix, kind: "fix" } : { lo: m[0], hi: m[1], kind: "meter" };
      function est(k, ub) { // оценка-диапазон: у Uber на маршруте аэропорта — их среднее
        var c = ub || m[0] * K[k]; return { lo: r5(c * 0.85), hi: r5(c * 1.25), c: c, kind: ub ? "avg" : "est" };
      }
      function mark(p) { p.kind = "est"; return p; }
      function add(prov, name, seats, p, href, note) { list.push({ prov: prov, name: name, seats: seats, lo: p.lo, hi: p.hi, c: p.c || (p.lo + p.hi) / 2, kind: p.kind, href: href, note: note || "" }); }
      var ub = rt && rt.uber;
      add("taxi", "Taxi", 0, taxi, null, taxi.kind === "fix" ? TXT.fixNote : TXT.meterNote);
      add("uber", "UberX", 0, est("std", ub && ub.x), U);
      add("uber", "Uber Comfort", 0, est("comfort", ub && ub.comfort), U);
      add("uber", "UberXL", 1, est("xl", ub && ub.x ? 104 : null), U);
      add("uber", "Uber Premium", 0, est("premium", ub && ub.x ? 127 : null), U);
      add("uber", "Uber Taxi", 0, taxi, U, TXT.appTaxi);
      var ux = ub && ub.x, uc = ub && ub.comfort; // нет своих данных Bolt/FREE NOW → та же оценка, что у Uber того же класса
      add("bolt", "Bolt", 0, mark(est("std", ux)), LINK.bolt);
      add("bolt", "Bolt Comfort", 0, mark(est("comfort", uc)), LINK.bolt);
      add("bolt", "Bolt XL", 1, mark(est("xl", ux ? 104 : null)), LINK.bolt);
      add("bolt", "Bolt Premium", 0, mark(est("premium", ux ? 127 : null)), LINK.bolt);
      add("bolt", "Bolt Taxi", 0, taxi, LINK.bolt, TXT.appTaxi);
      add("freenow", "FREE NOW Taxi", 0, taxi, LINK.freenow, TXT.appTaxi);
      add("freenow", "FREE NOW Ride", 0, mark(est("std", ux)), LINK.freenow);
      if (rt && rt.wt) add("transfer", "World Transfer", 0, { lo: rt.wt[0], hi: rt.wt[1], kind: "pre" }, LINK.wt);
      if (rt && rt.welcome) add("transfer", "Welcome Pickups", 0, { lo: rt.welcome[0], hi: rt.welcome[1], kind: "pre" }, LINK.welcome);
      // Bolt и FREE NOW без своих данных: при равенстве ставим ниже Uber, у которого данные есть
      list.forEach(function (o, i) { o.i = i; });
      list.sort(function (a, b) { return a.c - b.c || a.i - b.i; });
      return { list: list, rt: rt };
    }

    function price(o) {
      if (o.kind === "fix") return eur(o.lo);
      return Math.round(o.lo).toLocaleString(loc) + "–" + eur(o.hi);
    }
    function tag(o) {
      return { fix: TXT.fix, meter: TXT.meterT, est: TXT.est, avg: TXT.avg, pre: TXT.pre }[o.kind];
    }
    function render() {
      var r = options(), all = r.list, show = st.prov === "all" ? all : all.filter(function (o) { return o.prov === st.prov; });
      if (st.prov === "all") show = show.filter(function (o) { return !(o.prov !== "taxi" && /Taxi$/.test(o.name)); }); // в «Все» такси один раз
      var cheap = show.filter(function (o) { return o.kind !== "pre"; })[0] || show[0], dear = show[show.length - 1], firm = cheap && (cheap.kind === "fix" || cheap.kind === "meter");
      $("#cmp-count").textContent = TXT.count.replace("{n}", show.length);
      $("#cmp-list").innerHTML = show.map(function (o) {
        var best = o === cheap && show.length > 1, worst = o === dear && show.length > 2;
        var badge = best ? '<span class="row-tag row-best">★ ' + esc(firm ? TXT.cheapest : TXT.likely) + "</span>" : worst ? '<span class="row-tag row-worst">' + esc(TXT.priciest) + "</span>" : "";
        var inner = badge + '<span class="pv-logo pv-' + o.prov + '">' + esc(o.prov === "taxi" ? "TAXI" : o.name[0]) + "</span>" +
          '<span class="row-n"><strong>' + esc(o.name) + "</strong><small>" + esc(TXT.seats[o.seats]) + " · " + esc(tag(o)) + (o.note ? " · " + esc(o.note) : "") + "</small></span>" +
          '<span class="row-p' + (o.kind === "est" || o.kind === "avg" ? " row-p-est" : "") + '">' + (o.kind === "est" || o.kind === "avg" ? "≈ " : "") + price(o) + "</span>" +
          '<span class="row-go">' + esc(o.href ? TXT.open + " ›" : TXT.taxiGo) + "</span>";
        var cls = "row" + (best ? " is-best" : "") + (worst ? " is-worst" : "");
        return o.href ? '<a class="' + cls + '" href="' + esc(o.href) + '" rel="noopener">' + inner + "</a>" : '<div class="' + cls + '">' + inner + "</div>";
      }).join("");
      $("#cmp-est").hidden = st.prov === "taxi" || st.prov === "transfer";
      $("#cmp-sbahn").hidden = !(r.rt && (r.rt.from === "air" || r.rt.to === "air"));
    }

    function drawMap() {
      var rt = ROUTES.filter(function (x) { return x.id === st.route; })[0], path = $("#m-route");
      $$(".m-pt").forEach(function (g) { g.classList.remove("is-a", "is-b"); });
      if (!rt) { path.setAttribute("d", ""); $("#cmp-from").textContent = TXT.gps; $("#cmp-to").textContent = st.km + " km"; $("#cmp-gmaps").href = "https://www.google.com/maps/dir/?api=1&travelmode=driving&destination=M%C3%BCnchen"; return; }
      var a = XY[rt.from], b = XY[rt.to], cx = (a[0] + b[0]) / 2 + (b[1] - a[1]) * 0.2, cy = (a[1] + b[1]) / 2 - (b[0] - a[0]) * 0.2;
      path.setAttribute("d", "M" + a[0] + " " + a[1] + " Q " + cx + " " + cy + " " + b[0] + " " + b[1]);
      document.querySelector('.m-pt[data-pt="' + rt.from + '"]').classList.add("is-a");
      document.querySelector('.m-pt[data-pt="' + rt.to + '"]').classList.add("is-b");
      $("#cmp-from").textContent = rt.fromN; $("#cmp-to").textContent = rt.toN;
      var f = PL[rt.from], t = PL[rt.to];
      $("#cmp-gmaps").href = "https://www.google.com/maps/dir/?api=1&travelmode=driving&origin=" + f.lat + "," + f.lng + "&destination=" + t.lat + "," + t.lng;
    }

    function pick(id) {
      st.route = id;
      $$(".cmp-route").forEach(function (b) { b.setAttribute("aria-checked", b.dataset.route === id ? "true" : "false"); });
