---
import Base from "../../../layouts/Base.astro";
import { LANGS } from "../../../lib/data.js";
import { COUNTRIES, CL } from "../../../lib/countries.js";
import { CPHOTOS } from "../../../lib/photos.js";
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const c = CL[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base lang={lang} title={`${c.title} | TaxiCheck`} description={c.sub} path="countries/">
  <h1 slot="header">{c.title}</h1>
  <section>
    <p class="sub">{c.sub}</p>
    <div class="clist">
      {COUNTRIES.map((x) => <a class="ccard" href={`${base}/${lang}/countries/${x.slug}/`}><img src={`${base}/${CPHOTOS[x.slug].hero.src}`} alt="" width="1400" height="933" loading="lazy"><strong>{x.flag} {x.name[lang]}</strong><span>{x.hub}</span></a>)}
    </div>
    <p class="bg-credit">{({ru:"Фото",de:"Fotos",en:"Photos"})[lang]}: {COUNTRIES.map((x, i) => <>{i ? " · " : ""}<a href={CPHOTOS[x.slug].hero.url} rel="noopener">{CPHOTOS[x.slug].hero.by}</a> ({CPHOTOS[x.slug].hero.lic})</>)} · Wikimedia Commons</p>
  </section>
</Base>
