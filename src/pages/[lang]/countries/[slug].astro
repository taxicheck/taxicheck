---
import Base from "../../../layouts/Base.astro";
import Tips from "../../../components/Tips.astro";
import SectionNav from "../../../components/SectionNav.astro";
import { readySections } from "../../../lib/city.js";
import { LANGS, FEATURES } from "../../../lib/data.js";
import { COUNTRIES, CL } from "../../../lib/countries.js";
import { CPHOTOS } from "../../../lib/photos.js";
export function getStaticPaths() {
  return LANGS.flatMap((lang) => COUNTRIES.map((x) => ({ params: { lang, slug: x.slug }, props: { x } })));
}
const { lang } = Astro.params;
const { x } = Astro.props;
const c = CL[lang];
const tr = (v) => (typeof v === "string" ? v : v[lang]);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ph = CPHOTOS[x.slug];
const CR = { ru: "Фото", de: "Foto", en: "Photo" };
const TITLE = { ru: `Такси и Bolt/Uber: ${x.name.ru} — советы туристам`, de: `Taxi, Uber & Bolt: ${x.name.de} — Tipps für Reisende`, en: `Taxi, Uber & Bolt in ${x.name.en} — travel tips` };
---
<Base lang={lang} title={`${TITLE[lang]} | TaxiCheck`} description={tr(x.apps)} path={`countries/${x.slug}/`} bg={ph.hero} credits={[ph.hero, ph.taxi]}>
  <Fragment slot="header">
    <a class="back" href={`${base}/${lang}/countries/`}>{c.back}</a>
    <figure class="photo hero hero-compact"><img src={`${base}/${ph.hero.src}`} alt={ph.hero.alt[lang]} width="1400" height="933" fetchpriority="high"><div class="hero-text"><p class="city">{x.hub}</p><h1>{x.flag} {x.name[lang]}</h1></div></figure>
  </Fragment>
  {readySections(x.slug).length > 1 && <SectionNav lang={lang} only={readySections(x.slug)} />}
  <p class="draft">{c.note}</p>
  <section class="box">
    <h2>{c.apps}</h2>
    <p style="margin:0">{tr(x.apps)}</p>
  </section>
  <figure class="photo"><img src={`${base}/${ph.taxi.src}`} alt={ph.taxi.alt[lang]} width="1400" height="933" loading="lazy"><figcaption>{ph.taxi.alt[lang]}</figcaption></figure>
  <section class="box anchor" id="prices">
    <h2>{c.options}</h2>
    <p class="sub">{tr(x.route)}</p>
    <div class="opts">
      {x.options.map(([k, name, price]) => <div class="opt"><div><span class="k">{c.kinds[k]}</span>{tr(name)}</div><b>{tr(price)}</b></div>)}
    </div>
  </section>
  <section>
    <h2>{c.tips}</h2>
    <ol class="tipslist">{x.tips[lang].map((t) => <li>{t}</li>)}</ol>
  </section>
  {FEATURES.tips && <Tips lang={lang} scope={`c-${x.slug}`} where={x.name[lang]} />}
  <section>
    <details><summary>{c.src}</summary><ul>{x.src.map(([n, u, d]) => <li><a href={u} rel="noopener">{n}</a> · {d}</li>)}{[ph.hero, ph.taxi].map((p) => <li>{CR[lang]}: <a href={p.url} rel="noopener">{p.by}</a>, {p.lic} · Wikimedia Commons</li>)}</ul></details>
  </section>
</Base>
